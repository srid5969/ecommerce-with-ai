meta {
  name: List products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/products?page=1&limit=20
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  ~category: Snacks
  ~brand: Indomie
}

docs {
  Paginated product list. `limit` max 100.
  Enable `category` / `brand` (exact match) to filter.
}

tests {
  test("returns a page of products", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body.meta).to.include.keys("total", "page", "limit", "lastPage");
  });
}
